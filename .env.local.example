# Claro Hub Postgres (jetflo database)
# Note: do not add ?sslmode=require here — SSL is enforced via the explicit `ssl` option
# in src/lib/db.ts; combining both confuses pg's connection-string SSL parsing.
# jetflo_app: regular, RLS-enforced role used for all normal user-context queries
DATABASE_URL=postgresql://jetflo_app:<password>@db.claroenergy.in:5432/jetflo
# jetflo_service: BYPASSRLS role — equivalent of the old Supabase service-role client
DATABASE_ADMIN_URL=postgresql://jetflo_service:<password>@db.claroenergy.in:5432/jetflo

# Random string, 32+ chars — signs session cookies. Generate with: openssl rand -base64 32
SESSION_SECRET=

# GCS bucket for file storage (invoices, vendor docs) — replaces Supabase Storage.
# This bucket is shared across multiple projects; this app's files live under jetflo/.
GCS_BUCKET=claro-shared-storage
# Locally: omit this, uses `gcloud auth application-default login` instead.
# On Vercel: paste the claro-shared-storage-sa service account's JSON key here.
GCS_SERVICE_ACCOUNT_KEY=

# Notifications — Mailtrap SMTP relay for outbound email
# For Production / Sending Domain:
#   SMTP_HOST=live.smtp.mailtrap.io
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=api
#   SMTP_PASSWORD=<your_mailtrap_api_key>
#   SMTP_FROM="JetFlo Funds Portal <noreply@claroenergy.in>"
# For Sandbox Testing:
#   SMTP_HOST=sandbox.smtp.mailtrap.io
#   SMTP_PORT=2525
#   SMTP_USER=<sandbox_username>
#   SMTP_PASSWORD=<sandbox_password>
SMTP_HOST=live.smtp.mailtrap.io
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=api
SMTP_PASSWORD=
SMTP_FROM="JetFlo Funds Portal <noreply@claroenergy.in>"

# Public base URL used to build links inside notification emails
NEXT_PUBLIC_SITE_URL=http://localhost:3000
